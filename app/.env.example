# NENA EPRC PSAP-lookup API (GeoComm sandbox) — server-side only.
# Copy this file to `.env` and fill in real values. `.env` is gitignored;
# never commit real credentials.
#
# Consumed by server/eprc-proxy.ts via vite.config.ts's loadEnv(). Not
# VITE_-prefixed on purpose — Vite only exposes VITE_-prefixed vars to the
# client bundle, so these stay server-side.

EPRC_USERNAME=your-eprc-username
EPRC_PASSWORD=your-eprc-password

# Optional overrides — defaults match the GeoComm sandbox documented in
# docs/20251126 EPRC Sandbox API v.11 3/
# EPRC_TOKEN_URL=https://host1-gis-content-1.geocomm.cloud/arcgis/tokens/generateToken
# EPRC_QUERY_URL=https://host1-gis-content-1.geocomm.cloud/arcgis/rest/services/sandbox/NENA_EPRC_SAMPLE/FeatureServer/0/query

# Sandbox demo coordinate, used when the client omits lat/lng.
# EPRC_DEFAULT_LAT=33.80321
# EPRC_DEFAULT_LNG=-118.153234

# Token TTL in minutes (ArcGIS max is 1440 = 24h).
# EPRC_TOKEN_EXPIRATION_MINUTES=1440
